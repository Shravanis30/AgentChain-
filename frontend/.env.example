# AgentChain Frontend Environment Configuration Example
# Copy this file to .env.local: cp .env.example .env.local

# Backend FastAPI Gateway URL (default local: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Reown / WalletConnect Cloud Project ID for SIWE & Web3 wallet connection
# Get one for free at https://cloud.reown.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=3a8170812b534d0ff9d794f19a901d64

# EIP-4361 Sign-In with Ethereum (SIWE) Domain & URI
NEXT_PUBLIC_SIWE_DOMAIN=localhost:3000
NEXT_PUBLIC_SIWE_URI=http://localhost:3000

# AgentMarketplace Smart Contract Address (Polygon Amoy testnet / local deployment)
NEXT_PUBLIC_MARKETPLACE_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
